   "source": "fig, ax = plt.subplots(figsize=(8, 5))\nmodel_labels = [\"Published\\nPOSTER++\\n(Mao et al. 2023)\", \"This Run\\nPOSTER++\\n(reproduced)\"]\naccuracies   = [PUBLISHED_ACC, test_acc * 100]\ncolors       = [\"#4C72B0\", \"#55A868\"]\n\nbars = ax.bar(model_labels, accuracies, color=colors, width=0.4, edgecolor=\"white\")\nax.set_ylim(80, 100)\nax.set_ylabel(\"Accuracy on RAF-DB Test Set (%)\", fontsize=12)\nax.set_title(\"POSTER++ — Published vs Reproduced Accuracy\", fontsize=13, fontweight=\"bold\")\nax.axhline(PUBLISHED_ACC, color=\"#4C72B0\", linestyle=\"--\", linewidth=1, alpha=0.5)\nax.yaxis.set_major_formatter(mticker.FormatStrFormatter(\"%.1f%%\"))\n\nfor bar, acc in zip(bars, accuracies):\n    ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height() + 0.1,\n            f\"{acc:.2f}%\", ha=\"center\", va=\"bottom\", fontsize=12, fontweight=\"bold\")\n\nax.grid(True, axis=\"y\", alpha=0.3)\nplt.tight_layout()\nplt.savefig(\"results/posterv2_benchmark_comparison.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()\n\ngap = abs(test_acc * 100 - PUBLISHED_ACC)\nif gap < 0.5:\n    print(f\"✅ Reproduced within {gap:.2f}% — excellent match.\")\nelif gap < 1.5:\n    print(f\"⚠️  {gap:.2f}% gap — minor deviation, likely floating-point differences.\")\nelif gap < 3.0:\n    print(f\"⚠️  {gap:.2f}% gap — check you're using the correct RAF-DB test split.\")\nelse:\n    print(f\"❌ {gap:.2f}% gap — likely wrong checkpoint or wrong split.\")\n    print(\"  1. Confirm you downloaded the RAF-DB checkpoint (not AffectNet).\")\n    print(\"  2. Confirm lines starting with 'test_' in the label file.\")\n    print(\"  3. Confirm images are from the aligned/ folder.\")"
