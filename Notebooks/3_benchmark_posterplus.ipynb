   "source": "# ── Transform: POSTER++ uses standard ImageNet normalisation ─────────────────\n# (ResNet-50 and ViT-B/16 are both pre-trained on ImageNet)\nIMAGENET_MEAN = [0.485, 0.456, 0.406]\nIMAGENET_STD  = [0.229, 0.224, 0.225]\n\ntest_transform = transforms.Compose([\n    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n    transforms.ToTensor(),\n    transforms.Normalize(IMAGENET_MEAN, IMAGENET_STD),\n])\n\n\nclass RAFDBDataset(Dataset):\n    \"\"\"\n    Loads RAF-DB images from the aligned/ directory.\n    Label file format: '<filename> <label>\\n' where label is 1-indexed (1–7).\n    \"\"\"\n    def __init__(self, img_dir: Path, label_file: Path, split: str = \"test\", transform=None):\n        self.img_dir   = img_dir\n        self.transform = transform\n        self.samples   = []\n        missing        = 0\n\n        if not label_file.exists():\n            raise FileNotFoundError(\n                f\"\\nRAF-DB label file not found at:\\n  {label_file.resolve()}\\n\"\n                f\"Download RAF-DB from http://www.whdeng.cn/RAF/model1.html\\n\"\n                f\"and unzip into: {RAFDB_ROOT.resolve()}\"\n            )\n\n        with open(label_file) as f:\n            for line in f:\n                line = line.strip()\n                if not line:\n                    continue\n                parts = line.split()\n                fname, label_str = parts[0], parts[1]\n                if not fname.startswith(split):\n                    continue\n                label    = int(label_str) - 1    # 1-indexed → 0-indexed\n                # RAF-DB aligned images use the _aligned suffix\n                img_name = fname.replace(\".jpg\", \"_aligned.jpg\")\n                img_path = img_dir / img_name\n                if not img_path.exists():\n                    img_path = img_dir / fname   # try without suffix\n                if img_path.exists():\n                    self.samples.append((img_path, label))\n                else:\n                    missing += 1\n\n        print(f\"  Loaded {len(self.samples):,} {split} images  ({missing} not found on disk)\")\n\n    def __len__(self):\n        return len(self.samples)\n\n    def __getitem__(self, idx):\n        img_path, label = self.samples[idx]\n        img = Image.open(img_path).convert(\"RGB\")\n        if self.transform:\n            img = self.transform(img)\n        return img, label\n\n\n# ── Build dataset and dataloader ─────────────────────────────────────────────\nprint(\"Loading RAF-DB test split...\")\ntest_dataset = RAFDBDataset(\n    img_dir    = RAFDB_IMG_DIR,\n    label_file = RAFDB_LABEL_FILE,\n    split      = \"test\",\n    transform  = test_transform,\n)\ntest_loader = DataLoader(\n    test_dataset,\n    batch_size  = BATCH_SIZE,\n    shuffle     = False,\n    num_workers = NUM_WORKERS,\n    pin_memory  = (DEVICE.type == \"cuda\"),\n)\nprint(f\"  Batches: {len(test_loader)}\")\n\nif len(test_dataset) > 0:\n    print(\"\\nClass distribution in test set:\")\n    labels_list = [s[1] for s in test_dataset.samples]\n    for cls_id, cls_name in RAFDB_CLASSES.items():\n        count = labels_list.count(cls_id)\n        bar   = \"\\u2588\" * (count // 30)\n        print(f\"  {cls_id} {cls_name:<10}: {count:>4}  {bar}\")\nelse:\n    print(\"\\u26a0\\ufe0f  No test images loaded. Check the RAF-DB directory paths in Cell 2.\")"
  },
