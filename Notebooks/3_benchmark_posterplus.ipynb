   "source": "per_class_prec = precision_score(all_labels, all_preds, average=None, zero_division=0)\nper_class_rec  = recall_score(   all_labels, all_preds, average=None, zero_division=0)\nper_class_f1v  = f1_score(       all_labels, all_preds, average=None, zero_division=0)\n\nresults = {\n    \"model\":               \"POSTER++ (Mao et al., IEEE TPAMI 2023)\",\n    \"github\":              \"https://github.com/Talented-Q/POSTER_V2\",\n    \"dataset\":             \"RAF-DB (standard 7-class test set, 3,068 images)\",\n    \"test_size\":           int(len(all_labels)),\n    \"published_accuracy\":  PUBLISHED_ACC,\n    \"reproduced_accuracy\": round(float(test_acc * 100), 4),\n    \"gap_from_published\":  round(float(test_acc * 100 - PUBLISHED_ACC), 4),\n    \"macro_f1\":            round(float(macro_f1), 4),\n    \"weighted_f1\":         round(float(weighted_f1), 4),\n    \"per_class\":           {}\n}\n\nfor i, name in RAFDB_CLASSES.items():\n    results[\"per_class\"][name] = {\n        \"precision\": round(float(per_class_prec[i]), 4),\n        \"recall\":    round(float(per_class_rec[i]),  4),\n        \"f1\":        round(float(per_class_f1v[i]),  4),\n        \"support\":   int((all_labels == i).sum()),\n    }\n\nwith open(RESULTS_PATH, \"w\") as f:\n    json.dump(results, f, indent=2)\n\nprint(f\"✅ Results saved to {RESULTS_PATH}\")\nprint()\nbest_class  = max(results[\"per_class\"], key=lambda k: results[\"per_class\"][k][\"f1\"])\nworst_class = min(results[\"per_class\"], key=lambda k: results[\"per_class\"][k][\"f1\"])\nprint(f\"  Reproduced accuracy: {results['reproduced_accuracy']:.2f}%  (published: {PUBLISHED_ACC}%)\")\nprint(f\"  Macro F1           : {results['macro_f1']:.4f}\")\nprint(f\"  Best class         : {best_class} (F1={results['per_class'][best_class]['f1']:.3f})\")\nprint(f\"  Worst class        : {worst_class} (F1={results['per_class'][worst_class]['f1']:.3f})\")"
