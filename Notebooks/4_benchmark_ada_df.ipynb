   "source": "# ── Load all available results ────────────────────────────────────────────────\nresults_files = {\n    \"ResNet-18\\n(Baseline)\": Path(\"results/resnet18_results.json\"),\n    \"POSTER++\\n(SOTA)\": Path(\"results/posterv2_results.json\"),\n    \"Ada-DF\\n(Modern)\": RESULTS_RAFDB,  # loaded below if it exists\n}\n\n# Store Ada-DF RAF-DB results first\nada_rafdb_acc_pct = rafdb_acc * 100\n\n# Build comparison data\naccuracies_cmp = []\nmodel_names    = []\ncmap_colors    = [\"#DD8452\", \"#4C72B0\", \"#55A868\"]\n\nfor i, (label, fpath) in enumerate([\n    (\"ResNet-18\\n(Baseline)\", Path(\"results/resnet18_results.json\")),\n    (\"POSTER++\\n(SOTA, published)\", Path(\"results/posterv2_results.json\")),\n    (\"Ada-DF\\n(RAF-DB)\", None),   # use live value\n]):\n    if fpath is not None and fpath.exists():\n        with open(fpath) as f:\n            r = json.load(f)\n        acc = r.get(\"reproduced_accuracy\", r.get(\"test_accuracy\", 0)) * (\n            1 if r.get(\"reproduced_accuracy\") else 100\n        )\n        accuracies_cmp.append(acc)\n        model_names.append(label)\n    elif fpath is None:\n        accuracies_cmp.append(ada_rafdb_acc_pct)\n        model_names.append(label)\n    else:\n        print(f\"  \\u26a0\\ufe0f  {label.split(chr(10))[0]} results not found — skipping.\")\n\n# Adjust for stored values (resnet18 stores as 0–1, posterv2 stores as 0–100 percent)\n# If value < 2, assume it was stored as fraction and multiply by 100\naccuracies_cmp = [a * 100 if a < 2 else a for a in accuracies_cmp]\n\n# ── Bar chart ─────────────────────────────────────────────────────────────────\nfig, ax = plt.subplots(figsize=(10, 5))\nbars = ax.bar(\n    model_names, accuracies_cmp,\n    color=cmap_colors[:len(model_names)],\n    width=0.45, edgecolor=\"white\"\n)\nax.set_ylim(40, 100)\nax.set_ylabel(\"Accuracy on RAF-DB Test Set (%)\", fontsize=12)\nax.set_title(\"EmpathBot Benchmark Comparison — All Three Models on RAF-DB\", fontsize=13, 