   "source": "# ── SKIP THIS CELL if Cell 5a already loaded an official Ada-DF checkpoint ───\nprint(\"Building Ada-DF equivalent: EfficientNet-B2 with SE attention\")\nprint(\"=\" * 60)\n\ntry:\n    import timm\nexcept ImportError:\n    subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"timm\", \"-q\"])\n    import timm\n\nTRAIN_EPOCHS     = 40\nTRAIN_LR         = 3e-4\nTRAIN_BATCH_SIZE = 32\nLR_DECAY_STEP    = 12\nLR_DECAY_GAMMA   = 0.5\nEARLY_STOP       = 10\n\n\nclass AdaDFEquivalent(nn.Module):\n    \"\"\"\n    EfficientNet-B2 fine-tuned for FER.\n    Uses timm's built-in SE blocks for adaptive channel weighting —\n    matching Ada-DF's core idea of adaptive feature selection.\n    \"\"\"\n    def __init__(self, num_classes: int = 7, dropout: float = 0.3):\n        super().__init__()\n        self.backbone = timm.create_model(\n            \"efficientnet_b2\", pretrained=True, num_classes=0, drop_rate=dropout,\n        )\n        feat_dim = self.backbone.num_features  # 1408 for EfficientNet-B2\n        self.classifier = nn.Sequential(\n            nn.Dropout(p=dropout),\n            nn.Linear(feat_dim, 256),\n            nn.BatchNorm1d(256),\n            nn.ReLU(inplace=True),\n            nn.Dropout(p=dropout * 0.5),\n            nn.Linear(256, num_classes),\n        )\n\n    def forward(self, x):\n        return self.classifier(self.backbone(x))\n\n\ntrain_transform = transforms.Compose([\n    transforms.Resize((IMG_SIZE + 16, IMG_SIZE + 16)),\n    transforms.RandomCrop(IMG_SIZE),\n    transforms.RandomHorizontalFlip(p=0.5),\n    transforms.ColorJitter(brightness=0.3, contrast=0.3, saturation=0.2),\n    transforms.RandomRotation(degrees=10),\n    transforms.ToTensor(),\n    transforms.Normalize(IMAGENET_MEAN, IMAGENET_STD),\n])\n\n\nclass RAFDBTrainDataset(Dataset):\n    def __init__(self, img_dir, label_file, split=\"train\", transform=None):\n        self.img_dir = img_dir\n        self.transform = transform\n        self.samples = []\n        with open(label_file) as f:\n            for line in f:\n                parts = line.strip().split()\n                if len(parts) != 2:\n                    continue\n                fname, lbl = parts\n                if not fname.startswith(split):\n                    continue\n                label    = int(lbl) - 1\n                img_name = fname.replace(\".jpg\", \"_aligned.jpg\")\n                img_path = img_dir / img_name\n                if not img_path.exists():\n                    img_path = img_dir / fname\n                if img_path.exists():\n                    self.samples.append((img_path, label))\n\n    def __len__(self): return len(self.samples)\n\n    def __getitem__(self, idx):\n        img_path, label = self.samples[idx]\n        img = Image.open(img_path).convert(\"RGB\")\n        if self.transform:\n            img = self.transform(img)\n        return img, label\n\n\nprint(\"Loading RAF-DB train split...\")\ntrain_ds = RAFDBTrainDataset(RAFDB_IMG_DIR, RAFDB_LABEL_FILE, \"train\", train_transform)\nprint(f\"  Training images: {len(train_ds):,}\")\ntrain_loader_fb = DataLoader(train_ds, batch_size=TRAIN_BATCH_SIZE, shuffle=True,\n                             num_workers=NUM_WORKERS)\n\nmodel = AdaDFEquivalent(num_classes=7).to(DEVICE)\ncriterion = nn.CrossEntropyLoss()\noptimizer = optim.AdamW(model.parameters(), lr=TRAIN_LR, weight_decay=1e-4)\nscheduler = optim.lr_scheduler.StepLR(optimizer, step_size=LR_DECAY_STEP, gamma=LR_DECAY_GAMMA)\n\ntotal_params = sum(p.numel() for p in model.parameters())\nprint(f\"Model: EfficientNet-B2 (Ada-DF equiv.) | Params: {total_params:,} ({total_params/1e6:.1f}M)\")\nprint(f\"Training for {TRAIN_EPOCHS} epochs on {DEVICE}...\")\nprint(\"-\" * 55)\nprint(f\"{'Epoch':>6} | {'Train Loss':>10} | {'Train Acc':>9} | Status\")\nprint(\"-\" * 55)\n\nbest_acc = 0.0\nbest_epoch = 0\npatience_cnt = 0\n\nfor epoch in range(1, TRAIN_EPOCHS + 1):\n    model.train()\n    running_loss, correct, total = 0.0, 0, 0\n    for images, labels in train_loader_fb:\n        images, labels = images.to(DEVICE), labels.to(DEVICE)\n        optimizer.zero_grad()\n        outputs = model(images)\n        loss    = criterion(outputs, labels)\n        loss.backward()\n        optimizer.step()\n        running_loss += loss.item() * images.size(0)\n        correct      += (outputs.argmax(1) == labels).sum().item()\n        total        += images.size(0)\n    train_loss = running_loss / total\n    train_acc  = correct / total\n    scheduler.step()\n\n    status = \"\"\n    if train_acc > best_acc:\n        best_acc = train_acc\n        best_epoch = epoch\n        patience_cnt = 0\n        torch.save({\"epoch\": epoch, \"model_state_dict\": model.state_dict(),\n                    \"train_acc\": train_acc}, CKPT_RAFDB)\n        status = \"✅ saved\"\n    else:\n        patience_cnt += 1\n        if patience_cnt >= EARLY_STOP:\n            print(f\"\\nEarly stopping at epoch {epoch}.\")\n            break\n    print(f\"{epoch:>6} | {train_loss:>10.4f} | {train_acc:>8.1%} | {status}\")\n\nprint(\"-\" * 55)\nprint(f\"Training done. Best train acc: {best_acc:.1%} at epoch {best_epoch}.\")\nckpt = torch.load(CKPT_RAFDB, map_location=DEVICE)\nmodel.load_state_dict(ckpt[\"model_state_dict\"])\nmodel.eval()\nprint(\"✅ Best checkpoint loaded. Proceed to Cell 6.\")"
