   "source": "# Only run this cell if both the repo and checkpoint are available.\n# If you're using the training fallback (Cell 5b), skip this cell.\n\nassert ADADF_REPO_DIR.exists(), f\"Ada-DF repo not found at {ADADF_REPO_DIR}. Run Cell 4 first.\"\nassert CKPT_RAFDB.exists(),     f\"Checkpoint not found at {CKPT_RAFDB}. Run Cell 4 first.\"\n\n# ── Import model from cloned repo ────────────────────────────────────────────\n# UPDATE the import path to match the actual repo's model module.\n# Common patterns:\ntry:\n    from models.ada_df import AdaDFNet        # attempt 1\n    print(\"\\u2705 Imported AdaDFNet from models.ada_df\")\nexcept ImportError:\n    try:\n        from model import AdaDFNet            # attempt 2\n        print(\"\\u2705 Imported AdaDFNet from model\")\n    except ImportError:\n        print(\"\\u274c Could not import Ada-DF model class.\")\n        print(\"   Open the cloned repo and find the model class name, then update this cell.\")\n        raise\n\n# ── Build model and load checkpoint ──────────────────────────────────────────\nmodel_ada = AdaDFNet(num_classes=7)  # adjust constructor args to match the paper\nmodel_ada = model_ada.to(DEVICE)\n\nckpt = torch.load(CKPT_RAFDB, map_location=DEVICE)\nif isinstance(ckpt, dict):\n    key = next(\n        (k for k in [\"model_state_dict\", \"state_dict\", \"model\"] if k in ckpt), None\n    )\n    state_dict = ckpt[key] if key else ckpt\nelse:\n    state_dict = ckpt\n\nmodel_ada.load_state_dict(state_dict)\nmodel_ada.eval()\n\ntotal_params = sum(p.numel() for p in model_ada.parameters())\nprint(f\"Ada-DF loaded | Parameters: {total_params:,} ({total_params/1e6:.1f}M) | Device: {DEVICE}\")\n\n# Expose model under a common name used by evaluation cells below\nmodel = model_ada\nprint(\"\\n\\u2705 Using official Ada-DF checkpoint. Proceed to Cell 7 for RAF-DB evaluation.\")"
