   "source": "print(\"Loading RAF-DB test set...\")\nrafdb_test_ds = RAFDBDataset(\n    img_dir    = RAFDB_IMG_DIR,\n    label_file = RAFDB_LABEL_FILE,\n    split      = \"test\",\n    transform  = val_transform,\n)\nrafdb_test_loader = DataLoader(\n    rafdb_test_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS\n)\nprint(f\"  Batches: {len(rafdb_test_loader)}\")\n\nif len(rafdb_test_ds) == 0:\n    raise RuntimeError(\n        \"No RAF-DB test images found. Check RAFDB_IMG_DIR and RAFDB_LABEL_FILE in Cell 2.\"\n    )\n\n# ── Run inference ─────────────────────────────────────────────────────────────\nmodel.eval()\nrafdb_preds  = []\nrafdb_labels = []\n\nprint(\"\\nRunning Ada-DF inference on RAF-DB test set...\")\nwith torch.no_grad():\n    for images, labels in tqdm(rafdb_test_loader, desc=\"RAF-DB inference\"):\n        images   = images.to(DEVICE)\n        outputs  = model(images)\n        # Handle models that return multiple outputs (some Ada-DF variants)\n        if isinstance(outputs, (tuple, list)):\n            outputs = outputs[0]\n        preds = outputs.argmax(dim=1)\n        rafdb_preds.extend(preds.cpu().numpy())\n        rafdb_labels.extend(labels.numpy())\n\nrafdb_preds  = np.array(rafdb_preds)\nrafdb_labels = np.array(rafdb_labels)\n\n# ── Metrics ───────────────────────────────────────────────────────────────────\nrafdb_acc   = accuracy_score(rafdb_labels, rafdb_preds)\nrafdb_macro = f1_score(rafdb_labels, rafdb_preds, average=\"macro\")\nrafdb_wt    = f1_score(rafdb_labels, rafdb_preds, average=\"weighted\")\n\nprint()\nprint(\"=\" * 52)\nprint(\" RAF-DB RESULTS — Ada-DF\")\nprint(\"=\" * 52)\nprint(f\"  Overall accuracy  : {rafdb_acc * 100:.2f}%\")\nprint(f\"  Macro F1          : {rafdb_macro:.4f}\")\nprint(f\"  Weighted F1       : {rafdb_wt:.4f}\")\nprint()\n\nclass_name_list_7 = [RAFDB_CLASSES[i] for i in range(7)]\nprint(classification_report(rafdb_labels, rafdb_preds, target_names=class_name_list_7, digits=3))"
