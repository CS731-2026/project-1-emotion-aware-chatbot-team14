   "source": "comparison_models = [\n    (\"ResNet-18\\n(Baseline)\",  Path(\"results/resnet18_results.json\"),   \"test_accuracy\",      \"#DD8452\"),\n    (\"POSTER++\\n(SOTA)\",       Path(\"results/posterv2_results.json\"),   \"reproduced_accuracy\", \"#4C72B0\"),\n    (\"Ada-DF\\n(Modern)\",       None,                                    None,                  \"#55A868\"),\n]\n\nmodel_names  = []\naccuracies   = []\nbar_colors   = []\n\nfor label, fpath, key, color in comparison_models:\n    if fpath is not None and fpath.exists():\n        with open(fpath) as f:\n            r = json.load(f)\n        acc = r.get(key, 0)\n        # resnet18 stores as fraction (0–1), posterv2 as percent (0–100)\n        if acc < 2:\n            acc *= 100\n    elif fpath is None:\n        # use live Ada-DF RAF-DB result\n        acc = rafdb_acc * 100\n    else:\n        print(f\"  ⚠️  {label.split(chr(10))[0]} results not found — skipping\")\n        continue\n    model_names.append(label)\n    accuracies.append(acc)\n    bar_colors.append(color)\n\nfig, ax = plt.subplots(figsize=(10, 5))\nbars = ax.bar(model_names, accuracies, color=bar_colors, width=0.45, edgecolor=\"white\")\nax.set_ylim(40, 100)\nax.set_ylabel(\"Accuracy on RAF-DB Test Set (%)\", fontsize=12)\nax.set_title(\"EmpathBot Benchmark Comparison — All Three Models on RAF-DB\",\n             fontsize=13, fontweight=\"bold\")\nax.axhline(92.21, color=\"#4C72B0\", linestyle=\"--\", linewidth=1, alpha=0.6,\n           label=\"POSTER++ published (92.21%)\")\nax.legend(fontsize=9)\n\nfor bar, acc in zip(bars, accuracies):\n    ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height() + 0.3,\n            f\"{acc:.2f}%\", ha=\"center\", va=\"bottom\", fontsize=11, fontweight=\"bold\")\n\nax.grid(True, axis=\"y\", alpha=0.3)\nax.yaxis.set_major_formatter(mticker.FormatStrFormatter(\"%.0f%%\"))\nplt.tight_layout()\nplt.savefig(\"results/all_benchmarks_comparison.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()\nprint(\"✅ Saved: results/all_benchmarks_comparison.png\")\n\nprint()\nprint(\"─\" * 45)\nprint(f\"  {'Model':<25} {'Accuracy':>8}\")\nprint(f\"  {'-'*35}\")\nfor name, acc in zip(model_names, accuracies):\n    label = name.replace(\"\\n\", \" \")\n    print(f\"  {label:<25} {acc:>7.2f}%\")"
