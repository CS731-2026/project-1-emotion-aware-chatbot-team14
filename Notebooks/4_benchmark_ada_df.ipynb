   "source": "# Only run if affnet_available is True\nif affnet_available:\n    model.eval()\n    affnet_preds  = []\n    affnet_labels = []\n\n    print(\"Running Ada-DF inference on AffectNet test split...\")\n    with torch.no_grad():\n        for images, labels in tqdm(affnet_test_loader, desc=\"AffectNet inference\"):\n            images  = images.to(DEVICE)\n            outputs = model(images)\n            if isinstance(outputs, (tuple, list)):\n                outputs = outputs[0]\n            preds = outputs.argmax(dim=1)\n            affnet_preds.extend(preds.cpu().numpy())\n            affnet_labels.extend(labels.numpy())\n\n    affnet_preds  = np.array(affnet_preds)\n    affnet_labels = np.array(affnet_labels)\n\n    # ── Remap Ada-DF's 7-class RAF-DB predictions → EmpathBot 6 classes ─────\n    # Ada-DF RAF-DB class order: 0=surprise, 1=fear, 2=disgust, 3=happy, 4=sad, 5=angry, 6=neutral\n    # EmpathBot target labels (from master_split.csv): 0=neutral...5=distrust\n    # The label in master_split.csv IS already the EmpathBot label,\n    # so we only need to remap Ada-DF's output predictions.\n    RAFDB_PRED_TO_EMPATHBOT = {\n        0: 2,   # surprise  → sadness (closest)\n        1: 3,   # fear      → fear_anxiety\n        2: 5,   # disgust   → distrust\n        3: 1,   # happy     → trust_relief\n        4: 2,   # sad       → sadness\n        5: 5,   # angry     → distrust\n        6: 0,   # neutral   → neutral\n    }\n    affnet_preds_mapped = np.array([RAFDB_PRED_TO_EMPATHBOT[p] for p in affnet_preds])\n\n    # Metrics on 6-class EmpathBot labels\n    affnet_acc   = accuracy_score(affnet_labels, affnet_preds_mapped)\n    affnet_macro = f1_score(affnet_labels, affnet_preds_mapped, average=\"macro\", zero_division=0)\n    affnet_wt    = f1_score(affnet_labels, affnet_preds_mapped, average=\"weighted\", zero_division=0)\n\n    print()\n    print(\"=\" * 52)\n    print(\" AFFECTNET RESULTS — Ada-DF (6-class EmpathBot mapping)\")\n    print(\"=\" * 52)\n    print(f\"  Overall accuracy  : {affnet_acc * 100:.2f}%\")\n    print(f\"  Macro F1          : {affnet_macro:.4f}\")\n    print(f\"  Weighted F1       : {affnet_wt:.4f}\")\n    print()\n\n    class_name_list_6 = [EMPATHBOT_CLASSES[i] for i in range(6)]\n    print(classification_report(\n        affnet_labels, affnet_preds_mapped,\n        target_names=class_name_list_6, digits=3, zero_division=0\n    ))\nelse:\n    print(\"Skipping — AffectNet data not available.\")"
