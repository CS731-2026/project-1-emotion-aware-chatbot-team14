   "source": "# ── UPDATE THIS URL to the specific Ada-DF paper's GitHub repo ───────────────\n# Check your literature review reference for the correct URL.\nADADF_REPO_URL = \"https://github.com/xiongjun19/Ada-DF.git\"\n\n# ── Google Drive checkpoint ID — set from paper's README, or leave None ──────\nGDRIVE_CHECKPOINT_ID = None   # e.g. \"1AbCdEfGhIjKlMnOpQrStUv\"\n\nrepo_available = False\nif not ADADF_REPO_DIR.exists():\n    print(f\"Attempting to clone Ada-DF from: {ADADF_REPO_URL}\")\n    result = subprocess.run(\n        [\"git\", \"clone\", \"--depth=1\", ADADF_REPO_URL, str(ADADF_REPO_DIR)],\n        capture_output=True, text=True\n    )\n    if result.returncode == 0:\n        repo_available = True\n        print(\"✅ Ada-DF repo cloned.\")\n    else:\n        print(\"❌ Repo not found at that URL — check your literature review for the correct link.\")\n        print(f\"   Error: {result.stderr.strip()}\")\n        print(\"\\n   Falling back to built-in modern FER model (Cell 5b).\")\nelse:\n    repo_available = True\n    print(f\"✅ Ada-DF already exists at {ADADF_REPO_DIR}\")\n\nif repo_available and str(ADADF_REPO_DIR) not in sys.path:\n    sys.path.insert(0, str(ADADF_REPO_DIR))\n\n# ── Try to download checkpoint ────────────────────────────────────────────────\ncheckpoint_available = CKPT_RAFDB.exists()\n\nif not checkpoint_available and GDRIVE_CHECKPOINT_ID is not None:\n    print(f\"\\nDownloading checkpoint from Google Drive ...\")\n    try:\n        import gdown\n    except ImportError:\n        subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"gdown\", \"-q\"])\n        import gdown\n    try:\n        gdown.download(f\"https://drive.google.com/uc?id={GDRIVE_CHECKPOINT_ID}\",\n                       str(CKPT_RAFDB), quiet=False)\n        checkpoint_available = CKPT_RAFDB.exists()\n        if checkpoint_available:\n            print(f\"✅ Checkpoint downloaded to {CKPT_RAFDB}\")\n    except Exception as e:\n        print(f\"❌ Download failed: {e}\")\nelif checkpoint_available:\n    print(f\"✅ Checkpoint already exists at {CKPT_RAFDB} ({CKPT_RAFDB.stat().st_size/1e6:.0f} MB)\")\nelse:\n    print(\"\\nNo pre-trained weights found. Will use training fallback (Cell 5b).\")\n\nprint(f\"\\n  Repo available       : {repo_available}\")\nprint(f\"  Checkpoint available : {checkpoint_available}\")\nprint(\"\\n→ Run Cell 5a if BOTH are available.\")\nprint(\"→ Run Cell 5b (Training Fallback) if either is missing.\")"
