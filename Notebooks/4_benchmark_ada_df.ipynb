   "source": "n_rows = 2 if affnet_available else 1\nfig, axes = plt.subplots(n_rows, 2, figsize=(16, 6 * n_rows))\nfig.suptitle(\"Ada-DF — Confusion Matrices\", fontsize=14, fontweight=\"bold\")\nif n_rows == 1:\n    axes = np.array([axes])\n\n# ── RAF-DB ─────────────────────────────────────────────────────────────────────\ncm_rafdb      = confusion_matrix(rafdb_labels, rafdb_preds)\ncm_rafdb_norm = cm_rafdb.astype(float) / cm_rafdb.sum(axis=1, keepdims=True)\nclass_name_list_7 = [RAFDB_CLASSES[i] for i in range(7)]\n\nfor col, (data, title, fmt) in enumerate([\n    (cm_rafdb,      \"RAF-DB — Raw counts\",  \"d\"),\n    (cm_rafdb_norm, \"RAF-DB — Normalised\",  \".2f\"),\n]):\n    sns.heatmap(data, annot=True, fmt=fmt, cmap=\"Blues\",\n                xticklabels=class_name_list_7, yticklabels=class_name_list_7,\n                ax=axes[0, col], cbar_kws={\"shrink\": 0.8})\n    axes[0, col].set_xlabel(\"Predicted\", fontsize=10)\n    axes[0, col].set_ylabel(\"Actual\",    fontsize=10)\n    axes[0, col].set_title(title, fontsize=11)\n    axes[0, col].set_xticklabels(axes[0, col].get_xticklabels(), rotation=30, ha=\"right\", fontsize=8)\n    axes[0, col].set_yticklabels(axes[0, col].get_yticklabels(), rotation=0, fontsize=8)\n\n# ── AffectNet ──────────────────────────────────────────────────────────────────\nif affnet_available:\n    cm_affnet      = confusion_matrix(affnet_labels, affnet_preds_mapped)\n    cm_affnet_norm = cm_affnet.astype(float) / cm_affnet.sum(axis=1, keepdims=True)\n    class_name_list_6 = [EMPATHBOT_CLASSES[i] for i in range(6)]\n\n    for col, (data, title, fmt) in enumerate([\n        (cm_affnet,      \"AffectNet — Raw counts\",  \"d\"),\n        (cm_affnet_norm, \"AffectNet — Normalised\",  \".2f\"),\n    ]):\n        sns.heatmap(data, annot=True, fmt=fmt, cmap=\"Greens\",\n                    xticklabels=class_name_list_6, yticklabels=class_name_list_6,\n                    ax=axes[1, col], cbar_kws={\"shrink\": 0.8})\n        axes[1, col].set_xlabel(\"Predicted\", fontsize=10)\n        axes[1, col].set_ylabel(\"Actual\",    fontsize=10)\n        axes[1, col].set_title(title, fontsize=11)\n        axes[1, col].set_xticklabels(axes[1, col].get_xticklabels(), rotation=30, ha=\"right\", fontsize=8)\n        axes[1, col].set_yticklabels(axes[1, col].get_yticklabels(), rotation=0, fontsize=8)\n\nplt.tight_layout()\nplt.savefig(\"results/ada_df_confusion_matrices.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()\nprint(\"✅ Saved: results/ada_df_confusion_matrices.png\")"
