   "outputs": [],
   "source": "# ── Transform (inference only — no augmentation) ─────────────────────────────\nval_transform = transforms.Compose([\n    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n    transforms.ToTensor(),\n    transforms.Normalize(IMAGENET_MEAN, IMAGENET_STD),\n])\n\n\nclass RAFDBDataset(Dataset):\n    \"\"\"\n    RAF-DB test split loader.\n    Label file format: '<filename> <label>' where label is 1-indexed (1–7).\n    \"\"\"\n    def __init__(self, img_dir: Path, label_file: Path, split: str = \"test\", transform=None):\n        self.img_dir = img_dir\n        self.transform = transform\n        self.samples = []\n        missing = 0\n\n        with open(label_file) as f:\n            for line in f:\n                parts = line.strip().split()\n                if len(parts) != 2:\n                    continue\n                fname, lbl = parts\n                if not fname.startswith(split):\n                    continue\n                label    = int(lbl) - 1\n                img_name = fname.replace(\".jpg\", \"_aligned.jpg\")\n                img_path = img_dir / img_name\n                if not img_path.exists():\n                    img_path = img_dir / fname\n                if img_path.exists():\n                    self.samples.append((img_path, label))\n                else:\n                    missing += 1\n\n        print(f\"  RAF-DB {split}: {len(self.samples):,} images  ({missing} not found)\")\n\n    def __len__(self): return len(self.samples)\n\n    def __getitem__(self, idx):\n        img_path, label = self.samples[idx]\n        img = Image.open(img_path).convert(\"RGB\")\n        if self.transform:\n            img = self.transform(img)\n        return img, label\n\n\nclass MasterSplitDataset(Dataset):\n    \"\"\"\n    Loads AffectNet test images using the master_split.csv from notebook 1.\n    Filters to split='test' and source='affectnet'.\n    Labels are EmpathBot's 6-class scheme (0–5).\n    \"\"\"\n    def __init__(self, csv_path: Path, split: str = \"test\", source: str = \"affectnet\", transform=None):\n        self.transform = transform\n        df = pd.read_csv(csv_path)\n        df = df[(df[\"split\"] == split) & (df[\"source\"] == source)].reset_index(drop=True)\n        # Only keep rows where the file actually exists\n        valid = df[\"filepath\"].apply(lambda p: Path(p).exists())\n        missing = (~valid).sum()\n        self.df = df[valid].reset_index(drop=True)\n        print(f\"  AffectNet {split}: {len(self.df):,} images  ({missing} not found on disk)\")\n\n    def __len__(self): return len(self.df)\n\n    def __getitem__(self, idx):\n        row   = self.df.iloc[idx]\n        img   = Image.open(row[\"filepath\"]).convert(\"RGB\")\n        label = int(row[\"label\"])        # 0–5 EmpathBot labels\n        if self.transform:\n            img = self.transform(img)\n        return img, label\n\n\nprint(\"Dataset classes defined. Ready to build loaders in Cells 7 and 10.\")"
