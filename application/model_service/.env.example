PORT=8000
HOST=0.0.0.0

# ── STT ──────────────────────────────────────────────────────────────────────
STT_ENGINE=whisper-cpp
STT_MODEL=base.en
WHISPER_CPP_DIR=../../sandbox/student_taurajgreig/vendor/whisper.cpp

# ── Emotion model selection ─────────────────────────────────────────────────
# Preferred: pick a model by id from models.yaml.
# Leave commented out (and EMOTION_VARIANT=placeholder) to get a safe
# random-emotion fallback that doesn't require any model files on disk.
# Uncomment once models/empathbot/empath_final.pth is in place.
# EMOTION_MODEL_ID=empathbot_final

# Legacy fallback — only used when EMOTION_MODEL_ID is unset.
EMOTION_VARIANT=placeholder
# EMOTION_CHECKPOINT_PATH=models/your_model.pth
# EMOTION_DEVICE=mps                # cpu | mps | cuda — auto if unset

# ── Emotion debug flags (see core/debug_flags.py for runtime overrides) ─────
EMOTION_CYCLE_TEST_LABELS=false
EMOTION_CYCLE_INTERVAL_SECONDS=30
# EMOTION_FORCE_LABEL=sadness       # pin a specific label (must be in EMOTIONS)
EMOTION_LOG_PREDICTIONS=false

# ── LLM ─────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Claude Code provider (free for local dev; uses your `claude` CLI auth):
#   LLM_PROVIDER=claude-code
#   LLM_MODEL=haiku           # or sonnet / opus / full model id
#   CLAUDE_CLI=claude         # path to the claude binary (default: claude on PATH)
#   CLAUDE_CLI_TIMEOUT_SEC=180
