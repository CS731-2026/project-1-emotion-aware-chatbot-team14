flowchart LR
    subgraph BROWSER["Browser"]
        UI["+page.svelte<br/><i>chat UI</i>"]
        CAM["webcam capture<br/><i>+page.svelte</i>"]
        MIC["browserVad.ts<br/><i>mic + VAD</i>"]
    end

    subgraph FE["Frontend &mdash; SvelteKit :5173"]
        APIts["api.ts<br/><i>fetch wrappers</i>"]
        SSR["+page.server.ts<br/><i>SSR load</i>"]
    end

    subgraph BE["Backend &mdash; Express :3001"]
        BCHAT["chat.router.ts"]
        BPROF["profiles / history /<br/>session routers"]
        STORE[("profileStore<br/>data/profiles/")]
    end

    subgraph MS["Model Service &mdash; FastAPI :8000"]
        WSH["ws/handler.py<br/><i>dispatcher</i>"]
        VID["ws/video.py"]
        AUD["ws/audio.py"]
        FACE["core/face_detector.py<br/><i>YOLOv8</i>"]
        EMO["core/emotion/*<br/><i>EmpathBotV1</i>"]
        STT["core/stt/*<br/><i>whisper</i>"]
