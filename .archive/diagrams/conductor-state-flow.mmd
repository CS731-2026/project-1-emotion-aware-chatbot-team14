flowchart TB
    %% ═══════════════════════════════════════════════════════════════════
    %% TOP: per-turn lifecycle that runs each user message.
    %% The conductor decides which state is "live", supplies its
    %% intention to the LLM, then may transition based on the LLM's reply.
    %% ═══════════════════════════════════════════════════════════════════
    subgraph LIFECYCLE["One conversation turn — runs every user message"]
        direction LR
        L1["① conductor.observe(ctx)<br/><i>tick the live state once</i>"]
        L2["② live state.tick(ctx)<br/><i>returns intention + maybe advance</i>"]
        L3["③ LLMReasoningAgent.reason(...)<br/><i>intention + history + emotion + transcript</i>"]
        L4["④ conductor.handle_emission_advance()<br/><i>if LLM appended [[advance]]</i>"]
        L1 --> L2 --> L3 --> L4
    end

    %% ═══════════════════════════════════════════════════════════════════
    %% MIDDLE: the six-state session flow. Linear, no branching.
    %% Forms drive the check-in UI surface; yarns drive the chat surface.
    %% ═══════════════════════════════════════════════════════════════════
    subgraph FLOW["Session flow — SESSION_FLOW in conductor/states.py"]
        direction LR
        S1["📋 <b>QA_FORM</b><br/>form<br/><i>'doctor explained?',<br/>'feel confident?',<br/>'symptom instructions?'</i>"]
        S2["💬 <b>POST_QA_YARN</b><br/>yarn<br/><i>open chat after Q&amp;A —<br/>acknowledge concerns,<br/>bridge to feedback</i>"]
        S3["📋 <b>FEEDBACK_FORM</b><br/>form<br/><i>'noticed AI?',<br/>'feeling about it?',<br/>'privacy safe?'</i>"]
        S4["💬 <b>POST_FEEDBACK_YARN</b><br/>yarn<br/><i>thank, address any worry,<br/>invite final question</i>"]
        S5["💬 <b>CLOSING_YARN</b><br/>yarn<br/><i>say goodbye,<br/>remind anonymity</i>"]
        S6["✅ <b>DONE</b><br/>done<br/><i>terminal — no further ticks</i>"]

        S1 ==>|"<b>form_completed</b><br/><i>frontend posts event<br/>when user submits form</i>"| S2
        S2 ==>|"<b>turn_in_state ≥ 3</b><br/><i>OR LLM emits</i><br/><b>[[advance]]</b>"| S3
        S3 ==>|"<b>form_completed</b>"| S4
        S4 ==>|"<b>turn_in_state ≥ 4</b><br/><i>OR LLM emits</i><br/><b>[[advance]]</b>"| S5
        S5 ==>|"<b>turn_in_state ≥ 4</b><br/><i>OR LLM emits</i><br/><b>[[advance]]</b>"| S6
    end

    %% ═══════════════════════════════════════════════════════════════════
    %% BOTTOM: each state determines the UI surface the frontend mounts.
    %% Forms ↔ checkin questionnaire UI. Yarns ↔ open chat UI. Done ↔ end screen.
    %% ═══════════════════════════════════════════════════════════════════
    subgraph SURFACE["Frontend surface (UI mode the state selects)"]
        direction LR
        U1["🖥️ <b>checkin</b><br/><i>structured questionnaire form</i><br/><i>(form states)</i>"]
        U2["🖥️ <b>chat</b><br/><i>open conversation bubble</i><br/><i>(yarn states)</i>"]
        U3["🖥️ <b>done</b><br/><i>end-of-session screen</i><br/><i>(done state)</i>"]
    end

    %% ═══════════════════════════════════════════════════════════════════
    %% ADVANCE MECHANISMS — call out the two ways forward motion happens.
    %% Drawn as a side card so readers see WHY transitions fire.
    %% ═══════════════════════════════════════════════════════════════════
    subgraph ADVANCE["Two ways the flow advances"]
        direction TB
        A1["🛠️ <b>hard_advance(ctx)</b><br/><i>deterministic — runs pre-LLM in tick()</i><br/><b>form_completed</b> for forms<br/><b>turn_in_state ≥ N</b> for yarns"]
        A2["🤖 <b>LLM [[advance]] emission</b><br/><i>conversational — runs post-LLM</i><br/>yarn's <b>advance_instruction</b> tells LLM<br/>'append [[advance]] when patient signals<br/>they're ready'"]
    end

    %% ═══════════════════════════════════════════════════════════════════
    %% Cross-layer wiring — show how the live state plugs into the lifecycle
    %% and which UI surface each state kind maps to.
    %% ═══════════════════════════════════════════════════════════════════
    L2 -.->|"the LIVE state<br/>is one of these"| FLOW

    S1 -.-> U1
    S3 -.-> U1
    S2 -.-> U2
    S4 -.-> U2
    S5 -.-> U2
    S6 -.-> U3

    ADVANCE -.->|"each state arrow is fired<br/>by one of these mechanisms"| FLOW

    %% ═══════════════════════════════════════════════════════════════════
    %% Colour palette — match the existing system-topology diagram.
    %% ═══════════════════════════════════════════════════════════════════
    classDef formstate fill:#ffe1f0,stroke:#a04070,color:#5a1040,font-weight:bold
    classDef yarnstate fill:#dde7ff,stroke:#3050a0,color:#142060,font-weight:bold
    classDef donestate fill:#e6f7e6,stroke:#3a8a3a,color:#1a4a1a,font-weight:bold
    classDef surface fill:#fff4d6,stroke:#a67c00,color:#5a4500
    classDef lifecycle fill:#f4eaff,stroke:#704090,color:#301050
    classDef advance fill:#ffead0,stroke:#b07020,color:#603010

    class S1,S3 formstate
    class S2,S4,S5 yarnstate
    class S6 donestate
    class U1,U2,U3 surface
    class L1,L2,L3,L4 lifecycle
    class A1,A2 advance
