# Trained-weight binaries + HF cache live under models/. Source code
# there (architecture definitions for the training pipeline) is tracked.
/models/**/*.pth
/models/**/*.pt
/models/**/*.bin
/models/**/*.safetensors
/models/**/*.ipynb
/models/.locks/
/models/models--*/
.env
node_modules
sandbox/student_taurajgreig/vendor/

# git-weave vendors third-party repos under vendor/. The .thread files
# in vendor/ ARE tracked; the cloned repos themselves aren't.
vendor/*/

# `make install-training` copies (or, historically, symlinks) vendor/
# POSTER_V2 here so the model's Python imports resolve. No trailing
# slash — needs to match both real dirs (from cp -R) and symlinks
# (from `ln -s`, which git treats as a file).
pipeline/models/posterplus/POSTER_V2
.DS_Store
__pycache__/
*.pyc

# Training pipeline output — run dirs, cached datasets, checkpoints, artifacts.
# Everything generated by the pipeline lives here so the repo stays clean.
output/
